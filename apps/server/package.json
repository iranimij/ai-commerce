{
  "name": "@aicommerce/server",
  "version": "0.0.0",
  "description": "AI Commerce HTTP server: the action API, admin sign-in, OpenAPI and the job worker",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aicommerce/auth": "workspace:*",
    "@aicommerce/core": "workspace:*",
    "@aicommerce/db": "workspace:*",
    "@aicommerce/module-access": "workspace:*",
    "@aicommerce/module-media": "workspace:*",
    "@aicommerce/module-sample": "workspace:*",
    "@aicommerce/module-setup": "workspace:*",
    "@aicommerce/module-system": "workspace:*",
    "@hono/node-server": "2.1.8",
    "hono": "4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "otpauth": "9.6.0",
    "sharp": "0.35.5"
  }
}
