#!/bin/sh
# Run any command inside the app container: ./dev pnpm test
# ./dev ai-commerce <command> runs the CLI (build it first with ./dev pnpm build).
if [ "$1" = "ai-commerce" ]; then
  shift
  set -- node packages/cli/dist/bin.js "$@"
fi
if [ -t 0 ]; then
  exec docker compose run --rm app "$@"
else
  exec docker compose run --rm -T app "$@"
fi
