# Runtime role: no DDL, cannot change the audit log. Created by `./dev pnpm db:roles`.
DATABASE_URL=postgres://aicommerce_app:aicommerce_app@db:5432/aicommerce
# Owner role: runs migrations.
MIGRATION_DATABASE_URL=postgres://aicommerce:aicommerce@db:5432/aicommerce
# 32 random bytes, base64: openssl rand -base64 32. Encrypts secret settings; never change it casually.
AICOMMERCE_SECRET_KEY=
# At least 32 characters: openssl rand -base64 48. Signs admin sessions.
AICOMMERCE_AUTH_SECRET=
AICOMMERCE_PUBLIC_URL=http://localhost:3000
PORT=3000
# all, web or worker
AICOMMERCE_ROLE=all
AICOMMERCE_MODULES=system,access,sample
# Reverse proxies in front of the server (1 behind nginx).
AICOMMERCE_TRUSTED_PROXIES=0
