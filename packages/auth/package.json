{
  "name": "@aicommerce/auth",
  "version": "0.0.0",
  "description": "AI Commerce admin authentication: sessions, mandatory 2FA and roles",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aicommerce/core": "workspace:*",
    "@aicommerce/db": "workspace:*",
    "better-auth": "1.7.26",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "otpauth": "9.6.0"
  }
}
