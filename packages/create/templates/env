# Generated by npm create @aicommerce. Keep this file private and back it up: it holds the keys
# to your shop. Losing AICOMMERCE_SECRET_KEY makes stored secrets, such as AI keys, unreadable.

# The port on this machine, and the address people use to reach the shop. Change both together;
# behind a TLS proxy, set AICOMMERCE_PUBLIC_URL to the https address.
AICOMMERCE_PORT={{PORT}}
AICOMMERCE_PUBLIC_URL=http://localhost:{{PORT}}

AICOMMERCE_SECRET_KEY={{SECRET_KEY}}
AICOMMERCE_AUTH_SECRET={{AUTH_SECRET}}

# The owner runs migrations; the shop runs as aicommerce_app, which cannot change the schema.
POSTGRES_PASSWORD={{OWNER_PASSWORD}}
MIGRATION_DATABASE_URL=postgres://aicommerce:{{OWNER_PASSWORD}}@db:5432/aicommerce
DATABASE_URL=postgres://aicommerce_app:{{APP_PASSWORD}}@db:5432/aicommerce
