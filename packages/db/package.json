{
  "name": "@aicommerce/db",
  "version": "0.0.0",
  "description": "AI Commerce database: PostgreSQL connection, transactions, migrations and the audit log",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aicommerce/core": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  }
}
